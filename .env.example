# Sanity (client-side, safe to expose)
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2026-03-01

# WhatsApp (client-side, safe to expose)
# International format without + or spaces, e.g. 2348012345678
VITE_WHATSAPP_NUMBER=

# Mailchimp (SERVER-SIDE ONLY — set in Vercel dashboard, never VITE_ prefix)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=

# Contact form (SERVER-SIDE ONLY — set in Vercel dashboard, never VITE_ prefix)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=

# Sanity Studio (set in sanity/.env)
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production
